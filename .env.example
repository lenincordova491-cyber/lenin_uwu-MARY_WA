# Prefijo de comandos del bot
BOT_PREFIX=.

# Nombre que se muestra en mensajes del bot
BOT_NAME=MARY_WA

# Logo enviado por .menu; puede ser una ruta absoluta o relativa al proyecto
MENU_LOGO_PATH=LOGO BOT MAR_WA.jpg

# Número con código de país, sin +, espacios ni guiones
PAIRING_NUMBER=

# Credenciales de Spotify Developer para .spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Opcional: solo si en el futuro agregás comandos que dependan de NyxDLaPI ---
# (Spotify, Twitter/X, MediaFire, Google Drive, etc. NO están cubiertos por
# ruhend-scraper, así que si los sumás vas a necesitar esto)
# Conseguí tu key gratis en: https://nyxdlapi.vercel.app
NYX_BASE=https://nyxdlapi.vercel.app
NYX_API_KEY=
